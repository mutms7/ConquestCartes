{
  "name": "conquest-cartes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node api/relay.js",
    "check:relay": "node --check api/relay.js",
    "art:audit": "node tools/card-art-workflow.mjs audit",
    "art:batch": "node tools/card-art-workflow.mjs batch",
